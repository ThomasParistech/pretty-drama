          "lines": [
            {
              "id": "dev-l01",
              "characterId": "dev-c-alceste",
              "character": "Alceste",
              "text": "Qui va là ? Cette pièce n'est jouée par personne.",
              "status": "ok",
              "clip": "clips/dev-l01.mp3",
              "actIndex": 0,
              "sceneIndex": 0
            },
            {
              "id": "dev-l02",
              "characterId": "dev-c-eleonore",
              "character": "Éléonore de Trois-Rivières",
              "text": "Personne, en effet : nous sommes le banc d'essai du site.",
              "status": "ok",
              "clip": "clips/dev-l02.mp3",
              "actIndex": 0,
              "sceneIndex": 0
            },
            {
              "id": "dev-l03",
              "characterId": "dev-c-choeur",
              "character": "Le Chœur",
              "text": "Nous n'existons que pour être affichés, comptés et relus.",
              "status": "manquant",
              "clip": null,
              "actIndex": 0,
              "sceneIndex": 0
            },
            {
              "id": "dev-l04",
              "characterId": "dev-c-alceste",
              "character": "Alceste",
              "text": "Tenons-nous droit : quelqu'un regarde la grille d'avancement.",
              "status": "ok",
              "clip": "clips/dev-l04.mp3",
              "actIndex": 0,
              "sceneIndex": 0
            },
            {
              "id": "dev-l05",
              "characterId": "dev-c-eleonore",
              "character": "Éléonore de Trois-Rivières",
              "text": "« Enregistrée », « À refaire », « Manquante » : les trois états tiennent dans cet acte.",
              "status": "ok",
              "clip": "clips/dev-l05.mp3",
              "actIndex": 0,
              "sceneIndex": 0
            },
            {
              "id": "dev-l06",
              "characterId": "dev-c-choeur",
              "character": "Le Chœur",
              "text": "Et la barre ne doit jamais atteindre le bout.",
              "status": "manquant",
              "clip": null,
              "actIndex": 0,
              "sceneIndex": 0
            },
            {
              "id": "dev-l07",
              "characterId": "dev-c-alceste",
              "character": "Alceste",
              "text": "Plus fort, on ne t'entend pas au fond du casque.",
              "status": "manquant",
              "clip": null,
              "actIndex": 0,
              "sceneIndex": 0
            },
            {
              "id": "dev-l08",
              "characterId": "dev-c-eleonore",
              "character": "Éléonore de Trois-Rivières",
              "text": "C'est que ma réplique n'a pas encore de voix.",
              "status": "manquant",
              "clip": null,
              "actIndex": 0,
              "sceneIndex": 0
            }
          ]
        },
        {
          "lines": [
            {
              "id": "dev-l09",
              "characterId": "dev-c-un",
              "character": "Un",
              "text": "Moi ?",
              "status": "ok",
              "clip": "clips/dev-l09.mp3",
              "actIndex": 0,
              "sceneIndex": 1
            },
            {
              "id": "dev-l10",
              "characterId": "dev-c-choeur",
              "character": "Le Chœur",
              "text": "Toi. Ton nom tient en deux lettres : il éprouve les colonnes étroites.",
              "status": "manquant",
              "clip": null,
              "actIndex": 0,
              "sceneIndex": 1
            },
            {
              "id": "dev-l11",
              "characterId": "dev-c-un",
              "character": "Un",
              "text": "Bien.",
              "status": "ok",
              "clip": "clips/dev-l11.mp3",
              "actIndex": 0,
              "sceneIndex": 1
            }
          ]
        }
      ]
    },
    {
      "scenes": [
        {
          "lines": [
            {
              "id": "dev-l12",
              "characterId": "dev-c-eleonore",
              "character": "Éléonore de Trois-Rivières",
              "text": "Écoutez-moi jusqu'au bout, car cette tirade est ici pour occuper la place : elle déborde d'une ligne, elle déborde de deux, elle finira par déborder de la carte elle-même, et c'est très bien ainsi, puisqu'il faut bien qu'une réplique quelque part vérifie que le texte s'enroule proprement, que la carte grandit avec lui, que la colonne du tableau d'avancement le tronque sans le couper au milieu d'un mot, et que le PDF ne la laisse pas seule en bas d'une page.",
              "status": "manquant",
              "clip": null,
              "actIndex": 1,
              "sceneIndex": 0
            },
            {
              "id": "dev-l13",
              "characterId": "dev-c-alceste",
              "character": "Alceste",
              "text": "",
              "status": "manquant",
              "clip": null,
              "actIndex": 1,
              "sceneIndex": 0
            },
            {
              "id": "dev-l14",
              "characterId": "dev-c-un",
              "character": "Un",
              "text": "Une réplique sans texte vient de passer : la carte doit rester lisible.",
              "status": "manquant",
              "clip": null,
              "actIndex": 1,
              "sceneIndex": 0
            },
            {
              "id": "dev-l15",
              "characterId": "dev-c-alceste",
              "character": "Alceste",
              "text": "Et celle-ci a changé de mots depuis son enregistrement.",
              "status": "perime",
              "clip": "clips/dev-l15.mp3",
              "actIndex": 1,
              "sceneIndex": 0
            },
            {
              "id": "dev-l16",
              "characterId": "dev-c-eleonore",
              "character": "Éléonore de Trois-Rivières",
              "text": "Une apostrophe qui s’enjolive n’est pas une correction.",
              "status": "ok",
              "clip": "clips/dev-l16.mp3",
              "actIndex": 1,
              "sceneIndex": 0
            },
            {
              "id": "dev-l17",
              "characterId": "dev-c-choeur",
              "character": "Le Chœur",
              "text": "Le souffleur, lui, n'a pas une seule réplique.",
              "status": "manquant",
              "clip": null,
              "actIndex": 1,
              "sceneIndex": 0
            },
            {
              "id": "dev-l18",
              "characterId": "dev-c-alceste",
              "character": "Alceste",
              "text": "Il compte tout de même dans la distribution.",
              "status": "manquant",
              "clip": null,
              "actIndex": 1,
              "sceneIndex": 0
            }
          ]
        },
        {
          "lines": []
        }
      ]
    },
    {
      "scenes": [
        {
          "lines": [
            {
              "id": "dev-l19",
              "characterId": "dev-c-ingenue",
              "character": "L'Ingénue",
              "text": "J'arrive au dernier acte, et je n'ai parlé nulle part ailleurs.",
              "status": "ok",
              "clip": "clips/dev-l19.mp3",
              "actIndex": 2,
              "sceneIndex": 0
            },
            {
              "id": "dev-l20",
              "characterId": "dev-c-alceste",
              "character": "Alceste",
              "text": "Le menu des scènes ne te proposera donc que celle-ci.",
              "status": "perime",
              "clip": "clips/dev-l20.mp3",
              "actIndex": 2,
              "sceneIndex": 0
            },
            {
              "id": "dev-l21",
              "characterId": "dev-c-ingenue",
              "character": "L'Ingénue",
              "text": "Et l'acte entier à qui ne parle pas du tout.",
              "status": "manquant",
              "clip": null,
              "actIndex": 2,
              "sceneIndex": 0
            },
            {
              "id": "dev-l22",
              "characterId": "dev-c-choeur",
              "character": "Le Chœur",
              "text": "Rideau. Rien de tout cela n'est arrivé.",
              "status": "manquant",
              "clip": null,
              "actIndex": 2,
              "sceneIndex": 0
            }
          ]
        }
      ]
    }
